# ============================================================
# ShopHub — Git Ignore Rules
# Vue 3 + TypeScript + Vite frontend
# .NET 10 backend
# SQL Server
# ============================================================

# ------------------------------------------------------------
# Environment files and secrets
# Never commit real credentials or local environment settings.
# Safe example templates such as .env.example are allowed.
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Local application settings and secrets
appsettings.*.local.json
appsettings.Development.json
secrets.json
secrets/
*.pem
*.key
*.pfx
*.p12

# ------------------------------------------------------------
# .NET build output and local files
# ------------------------------------------------------------
**/bin/
**/obj/
**/TestResults/
*.user
*.suo
*.cache
*.pdb

# NuGet packages and temporary restore files
packages/
*.nupkg
*.snupkg

# Local databases, backups, and database logs
*.mdf
*.ldf
*.bak
*.backup
*.trn

# ------------------------------------------------------------
# Frontend dependencies and build output
# ------------------------------------------------------------
**/node_modules/
**/dist/
**/coverage/
**/.vite/

# Package-manager and bundler temporary files
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.tsbuildinfo

# ------------------------------------------------------------
# Playwright and test artifacts
# ------------------------------------------------------------
**/test-results/
**/playwright-report/
**/blob-report/
**/.playwright/
**/TestResults/

# ------------------------------------------------------------
# Python temporary files, if used by development scripts
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# ------------------------------------------------------------
# Logs and temporary files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.pid
*.swp
*.swo
*~

# ------------------------------------------------------------
# IDE and editor settings
# ------------------------------------------------------------
.vs/
.idea/
.vscode/
!.vscode/extensions.json

# ------------------------------------------------------------
# Operating system files
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ------------------------------------------------------------
# Local tooling and generated reports
# ------------------------------------------------------------
*.coverage
coverage.xml
.nyc_output/
.eslintcache
.stylelintcache

# ------------------------------------------------------------
# Archives and local exports
# Uncomment if you do not want local archives in Git.
# ------------------------------------------------------------
# *.zip
# *.tar
# *.tar.gz
# *.7z

