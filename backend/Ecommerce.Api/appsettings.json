{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1434;Database=ShopHubModernDb;User Id=sa;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "ShopHubApi",
    "Audience": "ShopHubClient",
    "SigningKey": "REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Database": {
    "AutoMigrate": true
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "GlobalPermitLimit": 300
  },
  "Seed": {
    "AdminEmail": "admin@shophub.local",
    "AdminPassword": "Admin@12345",
    "CustomerEmail": "customer@shophub.local",
    "CustomerPassword": "Customer@12345"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}